# --- Fonts ---
font_family JetBrains Mono Nerd Font
font_size 14
# disable_ligatures cursor
bold_font auto
italic_font auto
bold_italic_font auto

# Enable true color and undercurl support for lazyvim
term xterm-kitty

# Performance tweak for smooth rendering
repaint_delay 10
input_delay 3
sync_to_monitor yes

# --- Cursor ---
cursor_shape beam
cursor_blink_interval 0.5

# --- Scrollback ---
scrollback_lines 10000
wheel_scroll_multiplier 3

# --- Mouse ---
copy_on_select clipboard

# --- Bell ---
enable_audio_bell yes

# --- Window Layout ---
window_border_width 1pt
window_padding_width 8
confirm_os_window_close 1
window_margin_width 7
window_border_width 1pt
single_window_margin_width 0

enabled_layouts Tall, *

# --- Tab Bar ---
active_tab_foreground #dddddd
active_tab_background #cb1ed1
inactive_tab_foreground #909090
inactive_tab_background #313131
hide_window_decorations yes

tab_bar_style powerline
tab_powerline_style slanted

# --- Colors ---
background_opacity 0.85

# --- Advanced ---
allow_remote_control socket-only

# ----- Mappings -----
map f1 toggle_layout stack
map f5 launch --cwd=current --location=hsplit
map f6 launch --cwd=current --location=vsplit

# --- moving b/w windows 
map ctrl+h neighboring_window left
map ctrl+l neighboring_window right
map ctrl+j neighboring_window down
map ctrl+k neighboring_window up

# --- tab switch mappings -----
map alt+1 goto_tab 1
map alt+2 goto_tab 2
map alt+3 goto_tab 3
map alt+4 goto_tab 4
map alt+5 goto_tab 5
map alt+6 goto_tab 6
map alt+7 goto_tab 7
map alt+8 goto_tab 8
map alt+9 goto_tab 9
